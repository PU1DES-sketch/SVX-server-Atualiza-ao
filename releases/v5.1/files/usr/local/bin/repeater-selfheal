#!/usr/bin/env python3
"""Local-only health monitor for ProtoRadio.

The repeater must keep receiving and transmitting without a reflector,
Internet or Wi-Fi. This monitor never tests, restarts or reconfigures the
network. It only recovers local processes and the configured USB audio card.
"""

import json
import subprocess
import time
from datetime import datetime
from pathlib import Path

STATUS_FILE = Path("/var/www/html/repeater/status.json")
LOG_FILE = Path("/var/log/repeater-selfheal.log")
STATE_FILE = Path("/var/lib/repeater/selfheal/state.json")
STATUS_STALE_SEC = 180
AUDIO_RETRY_COOLDOWN_SEC = 900


def log(message: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write(f"{datetime.now():%F %T} {message}\n")


def run(command, timeout=30):
    return subprocess.run(command, text=True, capture_output=True, timeout=timeout)


def active(unit: str) -> bool:
    return subprocess.run(["systemctl", "is-active", "--quiet", unit]).returncode == 0


def restart(unit: str) -> bool:
    result = run(["systemctl", "restart", unit], timeout=45)
    if result.returncode == 0:
        log(f"servico reiniciado: {unit}")
        return True
    detail = (result.stderr or result.stdout).strip()
    log(f"falha ao reiniciar {unit}: {detail}")
    return False


def fresh(path: Path, max_age: int) -> bool:
    try:
        return time.time() - path.stat().st_mtime <= max_age
    except FileNotFoundError:
        return False


def usb_audio_present() -> bool:
    try:
        cards = Path("/proc/asound/cards").read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return False
    return "USB-Audio" in cards or "USB Audio Device" in cards


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {"last_audio_recovery": 0}


def save_state(state: dict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state), encoding="utf-8")


def recover_usb_audio() -> None:
    """Rebind USB audio only when it disappeared from ALSA."""
    log("placa de audio USB ausente; tentando recuperar ALSA local")
    if active("svxlink"):
        run(["systemctl", "stop", "svxlink"], timeout=40)

    unload = run(["modprobe", "-r", "snd_usb_audio"], timeout=25)
    if unload.returncode != 0:
        log("snd_usb_audio nao descarregou; continuando tentativa de recarga")
    load = run(["modprobe", "snd_usb_audio"], timeout=25)
    if load.returncode != 0:
        log("falha ao carregar snd_usb_audio")

    time.sleep(4)
    if usb_audio_present():
        log("placa de audio USB recuperada")
        restart("svxlink")
    else:
        log("placa de audio USB continua ausente; radio local preservado sem reboot")


def main() -> None:
    state = load_state()

    if not fresh(STATUS_FILE, STATUS_STALE_SEC):
        log("monitor de status sem atualizacao; reiniciando apenas status.service")
        restart("status.service")

    if not active("svxlink"):
        log("svxlink inativo; tentando reiniciar apenas o SvxLink")
        restart("svxlink")

    if not usb_audio_present():
        now = int(time.time())
        last = int(state.get("last_audio_recovery", 0))
        if now - last >= AUDIO_RETRY_COOLDOWN_SEC:
            state["last_audio_recovery"] = now
            recover_usb_audio()
        else:
            log("placa de audio USB ausente; aguardando proxima tentativa local")

    # No server ping, Internet probe, Wi-Fi restart or reboot is performed.
    # A remote outage must never interrupt RF receive/transmit.
    save_state(state)


if __name__ == "__main__":
    main()
