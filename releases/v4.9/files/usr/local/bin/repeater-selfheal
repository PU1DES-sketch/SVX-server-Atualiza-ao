#!/usr/bin/env python3
"""Conservative local health monitor for ProtoRadio.

This monitor intentionally never treats a remote server ping failure as a
local radio failure. A reflector or Internet outage must not interrupt a
working repeater. Network recovery remains delegated to NetworkManager and
the Wi-Fi fallback service.
"""

import json
import subprocess
import time
from datetime import datetime
from pathlib import Path

CONFIG = Path("/etc/repeater/config.json")
STATUS_FILE = Path("/var/www/html/repeater/status.json")
LOG_FILE = Path("/var/log/repeater-selfheal.log")
STATE_FILE = Path("/var/lib/repeater/selfheal/state.json")
STATUS_STALE_SEC = 180
NO_IP_RETRY_CYCLES = 5


def log(message: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write(f"{datetime.now():%F %T} {message}\n")


def run(command, timeout=25):
    return subprocess.run(command, text=True, capture_output=True, timeout=timeout)


def active(unit: str) -> bool:
    return subprocess.run(["systemctl", "is-active", "--quiet", unit]).returncode == 0


def restart(unit: str) -> bool:
    result = run(["systemctl", "restart", unit], timeout=40)
    if result.returncode == 0:
        log(f"servico reiniciado: {unit}")
        return True
    detail = (result.stderr or result.stdout).strip()
    log(f"falha ao reiniciar {unit}: {detail}")
    return False


def fresh(path: Path, max_age: int) -> bool:
    try:
        return time.time() - path.stat().st_mtime <= max_age
    except FileNotFoundError:
        return False


def has_ip() -> bool:
    result = run(["hostname", "-I"], timeout=5)
    return result.returncode == 0 and bool(result.stdout.strip())


def usb_audio_present() -> bool:
    try:
        cards = Path("/proc/asound/cards").read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return False
    return "USB-Audio" in cards or "USB Audio Device" in cards


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return {"no_ip_cycles": 0, "last_audio_notice": 0}


def save_state(state: dict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state), encoding="utf-8")


def main() -> None:
    state = load_state()

    # Repair only components proved to be local failures.
    if not fresh(STATUS_FILE, STATUS_STALE_SEC):
        log("monitor de status sem atualizacao; reiniciando status.service")
        restart("status.service")

    if not active("svxlink"):
        log("svxlink inativo; tentando reiniciar apenas o SvxLink")
        restart("svxlink")

    if not usb_audio_present():
        now = int(time.time())
        if now - int(state.get("last_audio_notice", 0)) >= 900:
            log("placa de audio USB ausente; preservando radio e aguardando recuperacao local")
            state["last_audio_notice"] = now

    if has_ip():
        state["no_ip_cycles"] = 0
    else:
        cycles = int(state.get("no_ip_cycles", 0)) + 1
        state["no_ip_cycles"] = cycles
        log(f"sem endereco IP local; ciclo {cycles}/{NO_IP_RETRY_CYCLES}")
        if cycles >= NO_IP_RETRY_CYCLES:
            # Do not restart NetworkManager: it can cut a healthy SSH/Wi-Fi
            # session. The fallback service is the least disruptive retry.
            log("sem IP persistente; solicitando somente o Wi-Fi fallback")
            restart("repeater-wifi-fallback.service")
            state["no_ip_cycles"] = 0

    # A remote server may reject ICMP or be under maintenance. Never restart
    # SvxLink, Wi-Fi or the Raspberry because a server ping failed.
    save_state(state)


if __name__ == "__main__":
    main()
